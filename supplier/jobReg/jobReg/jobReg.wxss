page {
  background: #f5f5f5;
  padding: 20rpx 20rpx 150rpx;
  box-sizing: border-box;
}

.myField .item .label {
  min-width: initial;
  max-width: initial;
  width: 165rpx;
}

.titleTab {
  background: #fff;
  border-bottom: 1rpx dashed #eee;
  padding: 20rpx 30rpx;
  margin-top: 20rpx;
  font-size: 26rpx;
}

.myField .item .con {
  flex: 1;
}

.myField .item .con .input-text {
  border: 1rpx solid #efefef;
  border-radius: 5rpx;
  padding: 10rpx;
  position: relative;
  font-size: 26rpx;
}
.myField .item .con .input-text>view{
  font-size: 26rpx;
}

.myField .item .con .arrow-down {
  position: absolute;
  right: 20rpx;
  top: 50%;
  color: #999;
  transform: translateY(-50%);
}

.myField .item .con input {
  border: 1rpx solid #efefef;
  border-radius: 5rpx;
  padding: 10rpx;
  position: relative;
  margin-top: 20rpx;
  font-size: 26rpx;
}

.myField .item .op {
  width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.myField .item .op .add {
  color: #1990ff;
  font-size: 40rpx;
}

.myField .item .op .clear {
  color: red;
  font-size: 40rpx;
  margin-left: 10rpx;
}

.footerBtn .total{
  float: left;
  line-height: 76rpx;
}
.footerBtn button{
  width: 250rpx;
  float: right;
}
.van-uploader__preview{
  margin: 0 20rpx 20rpx 0!important;
}
.myField .uploadImg{
  /* flex-direction: column; */
}
.myField .uploadImg .input-text{
  padding:0;
  margin-top: 10rpx;
}


/* 侧边选择栏 */
.filter-container{
  height: 100%;
}
.filter-container input{
  width: 90%;
  display: block;
  margin: 20rpx auto;
  border:1rpx solid #dee2e9;
  border-radius: 6rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  height: 80rpx;
}
.filter-container .scrollList{
  height: calc(100% - 120rpx);
}
.filter-container .scrollList .item{
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  border-bottom: 1rpx solid #dee2e9;
}
.filter-container .scrollList .item:first-child{
  border-top: 1rpx solid #dee2e9;
}
.filter-container .btn{
  margin:30rpx auto;
  width:200rpx;
}

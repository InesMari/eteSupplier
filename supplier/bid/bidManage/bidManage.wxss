page {
  background: #f5f5f5;
  height: 100%;
  padding-bottom: 0rpx;
  box-sizing: border-box;
}

.scorll {
  height: calc(100% - 120rpx);
}

.filter {
  line-height: 70rpx;
  background: #fff;
  text-align: center;
  font-size: 26rpx;
  border-bottom: 1rpx solid #efefef;
  margin: 20rpx 0 0;
}

.filter-container {
  padding: 30rpx;
  height: 100%;
  box-sizing: border-box;
  position: relative;
}

.filter-container .item {
  margin-bottom: 20rpx;
}

.filter-container .label {
  line-height: 50rpx;
  font-size: 26rpx;
}

.filter-container picker, .filter-container input{
  border: 1rpx solid #efefef;
  position: relative;
  line-height: 60rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}
.filter-container input{
  padding: 12rpx 20rpx;
}
.filter-container .arrow-down {
  position: absolute;
  right: 14rpx;
  top: 18rpx;
}

.filter-container .footBtn {
  position: absolute;
  bottom: 30rpx;
  text-align: center;
  left: 0;
  width: 100%;
}
.filter-container .footBtn button{
  margin: 0 20rpx;
}
.vehicleLengthList{
  border:1rpx solid #efefef;
  border-bottom: none;
  border-radius: 6rpx;
}
.vehicleLengthList .vItem{
  border-bottom: 1rpx solid #efefef;
  line-height: 70rpx;
  padding: 0 30rpx;
}
.vehicleLengthList .vItem.active{
  background-color: #1990ff;
  color: #fff;
}

.list{
  padding: 24rpx 30rpx;
  border-radius: 4rpx;
}
.list .item{
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
}
.list .item .inner{
  padding:28rpx 24rpx 0;
  border-bottom: 1rpx solid #F6F6F6;
}
.item .title{
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #efefef;
}
.item .title .router{
  line-height: 40rpx;
  float: left;
}
.item .title .state{
  float: right;
  line-height: 40rpx;
  font-size: 24rpx;
  width: 120rpx;
  height: 40rpx;
  background: #FFCDCD;
  border-radius: 50rpx;
  color: #E60012;
  text-align: center;
}
.item .title .state.state1{
  color: #0CCBF8;
  background: #E6F4F9;
}
.item .title .state.state2{
  color: #05D188;
  background: #E6F7F0;
}
.item .title .state.state3{
  color: #C5C5C5;
  background: #F1F2F5;
}
.item .title .state.state5{
  color: #FF7C1C;
  background: #FFDDCB;
}
.item .info{
  line-height: 40rpx;
  position: relative;
}
.item .info>view{
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  line-height: 40rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
}
.item .info .text{
  color: #666;
  color: #666;
  flex: 1;
  white-space: normal;
  word-break: break-all;
}
.item .info .line{
  width: 220rpx;
  position: relative;
  height: 4rpx;
  background: #333;
  margin:50rpx 20rpx;
}
.item .info .line van-icon{
  font-size: 34rpx;
  margin:-14rpx -12rpx;
  float: right;
}
.item .info .line .predictDistance{
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  text-align: center;
  line-height: 50rpx;
  font-size: 24rpx;
}
.item .info .line .predictTimeStr{
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  text-align: center;
  line-height: 50rpx;
  font-size: 24rpx;
}

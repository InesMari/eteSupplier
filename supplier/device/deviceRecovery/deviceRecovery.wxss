page {
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.myField {
  margin: 20rpx;
  border-radius: 12rpx;
}

.addView {
  text-align: center;
  font-size: 26rpx;
  color: #1990ff;
  margin-bottom: 20rpx;
  line-height: 70rpx;
  background: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
}

.deviceList {
  position: relative;
}

.deviceList van-icon {
  position: absolute;
  top: -5rpx;
  right: -5rpx;
  font-size: 36rpx;
  color: red;
  z-index: 99;
}


/* 线路信息 */
.wayTitle{
  font-size: 32rpx;
  line-height: 1;
  margin-bottom: 38rpx;
  padding: 30rpx 30rpx 0;
  font-weight: bold;
}
.wayTitle .tip{
  font-size: 24rpx;
  vertical-align: bottom;
  color: #999;
  font-weight: normal;
  margin-left: 15rpx;
}
.wayTitle .waySort{
  float: right;
  border-radius: 50rpx;
  color: #666;
  font-size: 26rpx;
  line-height: 48rpx;
  width: 148rpx;
  text-align: center;
  border:1rpx solid #C5C5C5;
  padding:0;
}
.wayInfo{
  margin: 20rpx;
  border-radius: 12rpx;
  background: #fff;
}
.wayInfo .list{
  padding:0 30rpx;
  border-bottom:1rpx solid #F6F6F6;
  position: relative;
}
.wayInfo .list::before{
  content: "";
  position: absolute;
  left: 46rpx;
  border-left: 1rpx solid #999;
  height: calc(100% - 96rpx);
  top: 27rpx;
}
.wayInfo .list .item{
  position: relative;
  margin-bottom:30rpx;
}
.wayInfo .list .item .state-img{
  position: absolute;
  height: 34rpx;
  width: 34rpx;
  left: 0;
  top: 0;
}
.wayInfo .list .item .van-icon-arrow{
  position: absolute;
  top: 12rpx;
  right: 0;
  font-size: 32rpx;
  color: #C5C5C5;
}
.wayInfo .list .item .content{
  float: right;
  width: calc(100% - 56rpx);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;  
  padding-right: 30rpx;
  box-sizing: border-box;
}
.wayInfo .list .item .content .name{
  font-size: 28rpx;
  margin-bottom: 18rpx;
}
.wayInfo .list .item .content .site{
  font-size: 26rpx;
}
.wayInfo .list .item .state{
  float:left;
  width: 72rpx;
  line-height: 28rpx;
  font-size:24rpx;
  text-align: right;
  margin-right: 12rpx;
} 
.wayInfo .myField{
  margin:0;
}

/* 侧边选择栏 */
.filter-container{
  height: 100%;
}
.filter-container input{
  width: 90%;
  display: block;
  margin: 20rpx auto;
  border:1rpx solid #dee2e9;
  border-radius: 6rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  height: 80rpx;
}
.filter-container .scrollList{
  height: calc(100% - 120rpx);
}
.filter-container .scrollList .item{
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #dee2e9;
}
.filter-container .scrollList .item:first-child{
  border-top: 1rpx solid #dee2e9;
}
.filter-container .btn{
  margin:30rpx auto;
  width:200rpx;
}

page{
  padding-bottom: 70rpx;
  background:#F1F2F5;
}
.addBank{
  padding: 34rpx 30rpx;
  font-size: 30rpx;
  background: #fff;
  border-radius: 18rpx;
  margin:24rpx 30rpx;
}
.addBank van-icon{
  font-size: 32rpx;
  vertical-align: top;
  margin-right: 12rpx;
}
.list{
  padding: 0 30rpx;
}
.list .item{
  border-radius: 18rpx;
  padding:30rpx 30rpx 88rpx;
  margin-bottom: 30rpx;
  position: relative;
  overflow: hidden;
}
.list .item.red{
  background: #ef3954;
}
.list .item.yellow{
  background:#f7f720;
}
.list .item.blue{
  background:#3939c5;
}
.list .item.orange{
  background:#ffba3b;
}
.list .item.green{
  background:#1bc156;
}
.list .swipe:nth-child(odd) .item{
  background:#E36565;
}
.list .swipe:nth-child(even) .item{
  background:#657AE3;
}
.list .item .bg{
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  top: 50%;
  margin-top: -160rpx;
  right: 42rpx;
  opacity: 0.1;
}
.bankIcon{
  float: left;
  border-radius: 50%; 
  width: 90rpx;
  height: 90rpx;
  margin-right: 18rpx;
  text-align: center;
  background: #fff;
}
.bankIcon image{
  width: 60rpx;
  height: 60rpx;
  display: inline-block;
  margin-top: 15rpx;
  vertical-align: top;
}
.info{
  float: left;
}
.info .name{
  font-size: 30rpx;
  color: #fff;
}
.info .type{
  font-size: 24rpx;
  color: #fff;
  margin-top: 18rpx;
}
.info .card_num{
  font-size: 36rpx;
  margin-top: 74rpx;
  color: #fff;
}
.van-swipe-cell__right{
  border-radius: 18rpx;
}
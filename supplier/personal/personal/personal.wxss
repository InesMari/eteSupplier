page{
  background: #F1F2F5;
}
.headInfo{
  position: relative;
  margin: 30rpx;
}
.headInfo .bg{
  width: 100%;
}
.headInfo .userInfo{
  position: absolute;
  top: 24rpx;
  left: 26rpx;
  z-index: 9;
}
.headInfo .userInfo .name{
  font-size: 30rpx;
  line-height: 1;
  margin-bottom: 16rpx;
  color: #fff;
}
.headInfo .userInfo .phone{
  font-size: 28rpx;
  line-height: 1;
  color: #fff;
}
.headInfo .personal,.comList .improveInfo{
  position: absolute;
  right: 0;
  top: 50%;
  transform:translateY(-50%);
  -webkit-transform:translateY(-50%);
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  line-height: 66rpx;
  height: 66rpx;
  background: rgba(0,0,0,0.4);
  padding:0 8rpx 0 24rpx;
  border-top-left-radius: 50rpx;
  border-bottom-left-radius: 50rpx;
  z-index: 9;
}
.headInfo .personal van-icon,.comList .improveInfo van-icon{
  vertical-align: middle;  
  margin-top: -2rpx;
}
.myField{
  margin: 0 30rpx 30rpx;
  border-radius: 18rpx;
  position: relative;
}
.myField .i_fee{
  width: 30rpx;
  height: 34rpx;
  margin-right: 18rpx;
  vertical-align: middle;
}
.myField .i_bank{
  width: 34rpx;
  height: 26rpx;
  margin-right: 14rpx;
  vertical-align: middle;
}
.myField .i_staff{
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  vertical-align: middle;
}
.myField .unit{
  position: absolute;
  right: 30rpx;
  top:18rpx;
}
.exit{
  border-radius: 18rpx;
  background: #fff;
  color: #333;
  line-height: 92rpx;
  text-align: center;
  font-size: 30rpx;
  margin:0 30rpx;
  border: none;
}
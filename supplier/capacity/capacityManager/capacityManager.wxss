page{
  background: #f5f5f5;
  height: 100%;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}
.mychart{
  width: 100%;
  height: 300rpx;
  padding-top: 20rpx;
}
.innerTab{
  padding: 20rpx;
  background: #fff;
}
.inner{
  display: flex;
  width: 500rpx;
  margin:0 auto;
  border-radius: 10rpx;
  border:1rpx solid #eee;
  background: #eee;
  overflow: hidden;
}
.inner view{
  flex: 1;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  color: #333;
  font-size: 24rpx;
}
.inner view:first-child{
  border-right:1rpx solid #eee;
}
.inner view.active{
  background: #1990ff;
  color: #fff;
}
.scorll{
  height: calc(100% - 360rpx);
  margin-top: 20rpx;
}
.scorll.minHeight{
  height: calc(100% - 525rpx);
}
.comList .info>view{
  margin:0;
  line-height: 40rpx;
  font-size: 24rpx;
}
.comList .header{
  height: auto;
  border-radius: 0;
}
.comList .header image{
  border-radius: 50%;
  margin-bottom: 10rpx;
}
.comList .header .match{
  line-height: 40rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: #1990ff;
  border-radius: 8rpx;
  width: 80%;
  margin: 0 auto;
}
.comList .header .match.noMatch{
  background: #E12006;
}

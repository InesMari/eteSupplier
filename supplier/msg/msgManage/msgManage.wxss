.tab{
  display: flex;
  border-bottom: 1rpx solid #e8e8e8;
}
.tab .item{
  flex:1;
  -webkit-flex:1;
  text-align: center;
  height: 90rpx;
  line-height: 90rpx;
}
.tab .item .count{
  display: inline-block;
  position: relative;
}
.tab .item .count::before{
  content: "";
  width: calc(100% + 30rpx);
  height: 4rpx;
  background-color: red;
  position: absolute;
  bottom:-1rpx;
  left: -15rpx;
  z-index: 99;
  display: none;
}
.tab .item.active .count::before{
  display: block;
}
.list .item{
  display: flex;
  padding:15rpx 24rpx;
  border-bottom:1rpx solid #e8e8e8;
  position: relative;
}
.list .item image{
  width: 90rpx;
  height: 90rpx;
  margin-right: 20rpx;
}
.list .item .info{
  flex:1;
  -webkit-flex:1;
}
.list .item .info .title{
  font-size: 30rpx;
  line-height: 36rpx;
  margin-top: 5rpx;
}
.list .item .info .time{
  font-size: 28rpx;
}
.list .item .info .content{
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  color: #999;
}
.list .item.unread::before{
  content: "";
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background: red;
  border-radius: 50%;
  left: 108rpx;
  top: 10rpx;
}
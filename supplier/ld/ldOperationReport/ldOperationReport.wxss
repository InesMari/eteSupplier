
.list{
  padding:0 30rpx;
  position: relative;
  overflow: hidden;
  margin-top: 40rpx;
}
.list::before{
  content: "";
  position: absolute;
  left: 44rpx;
  border-left: 1rpx solid #999;
  height: calc(100% - 130rpx);
  top: 27rpx;
}
.list .item{
  position: relative;
  margin-bottom:30rpx;
}
.state-img{
  position: absolute;
  height: 34rpx;
  width: 34rpx;
  left: 0;
  top: 0;
}
.list .item .content{
  /* float: left;
  width: calc(100% - 220rpx); */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-left: 50rpx;
}
.list .item .content .name{
  font-size: 28rpx;
}
.list .item .content .site{
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.list .item .content .time{
  margin: 16px 0;
}
.list .item .content .tihuo{
  line-height: 70rpx;
}
.list .item .content .tihuo input{
  display: inline-block;
  height:68rpx;
  border:1rpx solid #ebedf0;
  border-radius: 10rpx;
  vertical-align: middle;
  margin-left: 20rpx;
  padding:0 20rpx;
}
.list .item .state{
  float:left;
  width: 90rpx;
  line-height: 28rpx;
  font-size:24rpx;
  text-align: right;
  margin-right: 12rpx;
} 
.list .item .num{
  float:right;
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  border:1rpx solid #E12006;
  text-align: center;
  border-radius: 8rpx;
  color:#E12006;
} 
.list .item .num.disabled{
  border-color: #C5C5C5;
  color: #C5C5C5;
  pointer-events: none;
}

.jdTitle{
  border-top: 1rpx dashed #ebedf0;
  padding:30rpx;
}

.workList::before{
  height: calc(100% - 240rpx);
}
.nodeList::before{
  height: calc(100% - 90rpx);
}
input[disabled]{
  background: #F1F2F5!important;
}
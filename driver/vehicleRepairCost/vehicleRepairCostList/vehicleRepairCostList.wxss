page{
  background: #f5f5f5;
  height: 100%;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}
.van-tabs__line{
  left: 15rpx!important;
}
.scorll{
  height: calc(100% - 211rpx);
}

.list{
  padding: 24rpx 30rpx;
  border-radius: 4rpx;
}
.list .item{
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
}
.list .item .inner{
  padding:28rpx 24rpx 0;
  border-bottom: 1rpx solid #F6F6F6;
}
.item .title{
  margin-bottom: 32rpx;
  font-weight: bold;
}
.item .title .router{
  font-size: 32rpx;
  line-height: 40rpx;
  float: left;
}
.item .title .state{
  float: right;
  line-height: 40rpx;
  font-size: 24rpx;
  width: 120rpx;
  height: 40rpx;
  background: #FFCDCD;
  border-radius: 50rpx;
  color: #E60012;
  text-align: center;
}
.item .title .state.state1{
  color: #0CCBF8;
  background: #E6F4F9;
}
.item .title .state.state2{
  background: #FFCDCD;
  color: #E60012;
}
.item .title .state.state3{
  color: #C5C5C5;
  background: #F1F2F5;
}
.item .title .state.state5{
  color: #FF7C1C;
  background: #FFDDCB;
}
.item .isUrgent{
  border-radius: 50rpx;
  height: 30rpx;
  width: 60rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
  background: #E12006;
  margin: 8rpx 16rpx 0;
}
.item .info{
  line-height: 40rpx;
  position: relative;
}
.item .info>view{
  width: 50%;
  float: left;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  line-height: 1;
  margin-bottom: 28rpx;
}
.item .info .text{
  color: #666;
}
.operate{
  padding:18rpx 24rpx;
  line-height: 56rpx;
}
.operate .btn{
  background: #fff;
  line-height: 54rpx;
  height: 56rpx;
  border-radius: 50rpx;
  color: #E60012;
  font-size: 28rpx;
  width: 180rpx;  
  box-sizing: border-box;
}
.operate .btn::after{
  border: 1rpx solid #E60012;
}

.alertCompnent .content{
  padding: 40rpx 30rpx;
}
.alertCompnent .content .item{
  display: flex;
}
.alertCompnent .content .label{
  width: 200rpx;
  text-align: right;
  line-height: 50rpx;
  font-size: 24rpx;
}
.alertCompnent .content .text{
  line-height: 50rpx;
  flex: 1;
  font-size: 24rpx;
  position: relative;
}
.alertCompnent .content .text picker,.alertCompnent .content .text input{
  border: 1rpx solid #efefef;
  padding: 0 10rpx;
  border-radius: 6rpx;
}
.alertCompnent .content .text input{
  padding: 4rpx 10rpx;
}
.alertCompnent .content .arrow-down{
  position: absolute;
  right: 12rpx;
  top: 14rpx;
}
.alertCompnent .bottom{
  border-top:1rpx solid #f6f6f6;
}
.alertCompnent .bottom button{
  width: 50%;
  font-size: 24rpx;
  float: left;
  line-height: 80rpx;
  border-right:1rpx solid #f6f6f6;
  background: #fff;
  box-sizing: border-box;
}
.alertCompnent .bottom button:last-child{
  border:none;
  background: #ff4400;
  color: #fff;
  border-radius: 0;
  border-bottom-right-radius: 10rpx;
}
.van-uploader__preview-image,.van-uploader__upload{
  width: 200rpx!important;
  height: 200rpx!important;
}
.van-uploader__preview{
  margin: 0 20rpx 20rpx 0!important;
}
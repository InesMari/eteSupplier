<view class="myField">
  <view class="field-title">基本信息</view>
  <view class="item clearfix">
    <view class="label">车牌号</view>
    <view class="input-text">
      <picker mode="selector" disabled="{{disabled}}" range="{{vehicleData}}" bindchange="vehicleChange" range-key="plateNumber" value="{{vehicleIndex}}">
        <view wx:if="{{vehicleData.length !=0 &&vehicleIndex!=null}}">
          {{vehicleData[vehicleIndex].plateNumber}}
        </view>
        <view style="color:#c8c9cc;" wx:else>请选择车牌号</view>
        <van-icon name="arrow-down" class="arrow-down" />
      </picker>
    </view>
  </view>
  <view class="item clearfix">
    <view class="label"><text class="red">*</text>费用类型</view>
    <view class="input-text">
      <picker mode="selector" disabled="{{disabled}}" range="{{feeTypeData}}" bindchange="feeTypeChange" range-key="codeName" value="{{feeTypeIndex}}">
        <view wx:if="{{feeTypeData.length !=0 &&feeTypeIndex!=null}}">
          {{feeTypeData[feeTypeIndex].codeName}}
        </view>
        <view style="color:#c8c9cc;" wx:else>请选择</view>
        <van-icon name="arrow-down" class="arrow-down" />
      </picker>
    </view>
  </view>
  <!-- 选择（油费 燃气费 电费的时候）下面多出来一个项目（支付类型：垫付，补能） -->
  <view class="item clearfix" wx:if="{{info.feeType == 1 || info.feeType == 6 || info.feeType == 7}}">
    <view class="label"><text class="red">*</text>支付类型</view>
    <view class="input-text">
      <picker mode="selector" disabled="{{disabled}}" range="{{costPayData}}" bindchange="costPayChange" range-key="codeName" value="{{costPayIndex}}">
        <view wx:if="{{costPayData.length !=0 &&costPayIndex!=null}}">
          {{costPayData[costPayIndex].codeName}}
        </view>
        <view style="color:#c8c9cc;" wx:else>请选择</view>
        <van-icon name="arrow-down" class="arrow-down" />
      </picker>
    </view>
  </view>
  <view class="item clearfix">
    <view class="label"><text class="red">*</text>日期</view>
    <view class="input-text">
      <picker mode="date" disabled="{{disabled}}" value="{{info.feeDate}}" bindchange="bindDateChange" data-key="feeDate">
        <view wx:if="{{info.feeDate}}">
          {{info.feeDate}}
        </view>
        <view style="color:#c8c9cc;" wx:else>请选择</view>
        <van-icon name="arrow-down" class="arrow-down" />
      </picker>
    </view>
  </view>
  <view class="item clearfix">
    <view class="label"><text class="red">*</text>数量</view>
    <view class="input-text">
      <input type="digit" disabled="{{disabled}}" placeholder="数量" value="{{info.num}}" data-key="num" bindinput="inputSetItemDataDefault"></input>
    </view>
  </view>
  <view class="item clearfix">
    <view class="label">单位</view>
    <view class="input-text">
      <input type="text" disabled="{{disabled}}" placeholder="单位" value="{{info.unit}}" data-key="unit" bindinput="inputSetItemDataDefault"></input>
    </view>
  </view>
  <view class="item clearfix">
    <view class="label"><text class="red">*</text>金额</view>
    <view class="input-text">
      <input type="digit" disabled="{{disabled}}" placeholder="元" value="{{info.fee}}" data-key="fee" bindinput="inputSetItemDataDefault"></input>
    </view>
  </view>
  <view class="itemRemark">
    <view class="label">备注<text class="red">（油费需登记油品，路桥费需登记起止路线）</text></view>
    <view class="input-text">
      <input type="text" disabled="{{disabled}}" placeholder="请输入备注" value="{{info.remark}}" data-key="remark" bindinput="inputSetItemDataDefault"></input>
    </view>
  </view>
</view>
<view class="myField mt_20">
  <view class="field-title">附件</view>
  <view class="item-upload clearfix">
    <view class="upload-box">
      <van-uploader file-list="{{fileList}}" bind:after-read="afterRead" show-upload="{{(fileList.length<6 || !fileList) && !disabled}}" data-id="idCardBack" disabled="{{disabled}}" deletable="{{!disabled}}">
      </van-uploader>
    </view>
  </view>
</view>
<view class="myField mt_20">
  <view class="field-title">付款截图</view>  
  <view class="uploadTip">
    <view>注：</view>
    <view>微信付款要清晰显示转账单号或交易单号;</view>
    <view>支付宝付款要清晰显示订单号(点开更多才会显示);</view>
    <view>其他支付方式，也需清晰显示对应的单号;</view>
  </view>
  <view class="item-upload clearfix">
    <view class="upload-box">
      <van-uploader file-list="{{receiptsList}}" bind:after-read="afterReadReceipt" show-upload="{{(fileList.length<6 || !fileList) && !disabled}}" data-id="idCardBack" disabled="{{disabled}}" deletable="{{!disabled}}">
      </van-uploader>
    </view>
  </view>
</view>
<view class="footerBtn" bindtap="submit" wx:if="{{!disabled}}">
  <button>提交</button>
</view>
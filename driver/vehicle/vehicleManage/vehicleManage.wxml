<van-search value="{{ value }}" bind:change="search" placeholder="搜索车牌" />
<image mode="widthFix" wx:if="{{isRefresh}}" class="loading-icon" src="/common/images/loading.gif"></image>
<scroll-view class="scorll" scroll-y="{{true}}" bindscrolltoupper="toupper" upper-threshold="1" bindscrolltolower="scrolltolowerHandler">
  <view class="comList">
    <van-swipe-cell right-width="{{ 65 }}" left-width="{{ 0 }}" wx:for="{{list}}" wx:key="{{index}}" >
      <view class="clearfix item" slot="" bindtap="toDetail" data-id="{{item.vehicleId}}" data-state="{{item.authStateInternal}}" >
        <view class="header">
          <image src="/common/images/vehicleHeader.png"></image>
        </view>
        <view class="info">
          <view class="name" style="line-height:40rpx;">{{item.vehicleLengthName}}<text class="ml_20">{{item.vehicleTypeName}}</text>
            <!-- <view class="state green-bg" wx:if="{{item.authStateInternal==0}}">运作中</view> -->
            <view class="state skyBlue-bg" wx:if="{{item.authStateInternal==1}}">空闲中</view>
            <view class="state gray-bg" wx:if="{{item.authStateInternal==0}}">审核中</view>
            <view class="state red-bg" wx:if="{{item.authStateInternal==2}}">不通过</view>
          </view>
          <view class="phone">{{item.plateNumber}}</view>
          <view class="phone zt_999" wx:if="{{item.authStateInternal==2}}">不通过原因：{{item.authRemarkInternal}}</view>
          <image wx:if="{{item.lockNum}}" class="unlock" mode="widthFix" src="/common/images/unlock.png" data-item="{{item}}" catchtap="unlock"></image>
        </view>
        
      </view>
      <view slot="right" catchtap="delVehicle" data-id="{{item.vehicleId}}" style="line-height:200rpx;">删除</view>
    </van-swipe-cell>
  </view>
</scroll-view>

<view class="footerBtn">
  <button bindtap="toAddVehicle">新增车辆</button>
</view>